# Copy to terraform.tfvars and edit, or pass with -var-file.
subscription_id      = "00000000-0000-0000-0000-000000000000"
resource_group_name  = "rg-foundry-eastus2"
foundry_account_name = "foundry-demo-eus2" # must be globally unique + DNS-safe
project_name         = "proj-demo-eus2"

# Networking (private access). Subnets are /26.
vnet_name                              = "vnet-foundry-eus2"
virtual_network_address_space          = "192.168.0.0/24"
agent_subnet_address_prefix            = "192.168.0.0/26"
private_endpoint_subnet_address_prefix = "192.168.0.64/26"

# Agents (optional). Leave false for plain model serving.
enable_agent_capability_host = false

# Model to deploy (catalog key). This branch focuses on Anthropic (Opus/Sonnet).
#   terraform apply -var 'model_name=claude-sonnet'
# NOTE: Anthropic models need a one-time Marketplace agreement accepted on the
# subscription (portal: Model catalog -> the Claude model -> Agree) before apply.
model_name = "claude-opus"

# REQUIRED for Anthropic (Claude) models - sent as modelProviderData.
# industry must be lowercase: technology | finance | healthcare | education |
# retail | manufacturing | government | media | other
model_provider_industry          = "technology"
model_provider_organization_name = "Your Organization Legal Name"
model_provider_country_code      = "US"

tags = {
  project     = "model-serving"
  environment = "dev"
  managed_by  = "terraform"
}
