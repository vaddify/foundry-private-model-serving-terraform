subscription_id           = "00000000-0000-0000-0000-000000000000"
agent_resource_group_name = "rg-foundry-agent"
foundry_account_name      = "foundry-agent-eus2" # globally unique + DNS-safe
project_name              = "proj-agent-eus2"
enable_capability_host    = true

# Shared network (from the network root)
network_resource_group_name = "rg-foundry-network"
vnet_name                   = "vnet-foundry-eus2"
pe_subnet_name              = "snet-pe"

# Agent subnet (created in the shared VNet, reserved for agents)
agent_subnet_name   = "snet-agent"
agent_subnet_prefix = "192.168.0.0/26"

tags = {
  project     = "model-serving"
  environment = "dev"
  managed_by  = "terraform"
  workload    = "agents"
}
